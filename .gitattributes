# 统一行尾为 LF：容器与 Linux CI 不认 CRLF
# 否则 shell 脚本会报 bad interpreter: /bin/bash^M
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# 二进制资产不做行尾转换
*.png       binary
*.jpg       binary
*.webp      binary
*.gif       binary
